<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/back_button"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_back"
            android:tint="@color/text_primary" />

        <TextView
            android:id="@+id/mode_text"
            style="@style/ScreenTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/mode_tradition" />
    </LinearLayout>

    <com.pilot.voiceassistant.ui.VoiceOrbView
        android:id="@+id/orb_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="5" />

    <TextView
        android:id="@+id/state_text"
        style="@style/StateText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/state_connecting" />

    <TextView
        android:id="@+id/wake_text"
        style="@style/HintText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp" />

    <com.pilot.voiceassistant.ui.AutoHideTextView
        android:id="@+id/error_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_error"
        android:padding="14dp"
        android:textColor="@color/error"
        android:textSize="18sp" />

    <!-- The last exchange: what the user said on the right, the answer on the left. -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="4"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:orientation="vertical">

            <com.pilot.voiceassistant.ui.AutoHideTextView
                android:id="@+id/transcript_text"
                style="@style/Bubble"
                android:layout_gravity="end"
                android:layout_marginStart="48dp"
                android:background="@drawable/bg_bubble_user" />

            <com.pilot.voiceassistant.ui.AutoHideTextView
                android:id="@+id/response_text"
                style="@style/Bubble"
                android:layout_gravity="start"
                android:layout_marginEnd="48dp"
                android:background="@drawable/bg_bubble_assistant" />
        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/talk_button"
        style="@style/TalkButton"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:enabled="false"
        android:text="@string/talk_button" />

</LinearLayout>
