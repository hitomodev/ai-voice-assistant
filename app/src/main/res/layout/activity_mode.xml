<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/mode_title"
        android:textSize="40sp" />

    <Button
        android:id="@+id/tradition_button"
        android:layout_width="320dp"
        android:layout_height="96dp"
        android:layout_marginTop="32dp"
        android:text="@string/mode_tradition"
        android:textSize="28sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/mode_tradition_hint"
        android:textSize="18sp" />

    <Button
        android:id="@+id/modern_button"
        android:layout_width="320dp"
        android:layout_height="96dp"
        android:layout_marginTop="24dp"
        android:text="@string/mode_modern"
        android:textSize="28sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/mode_modern_hint"
        android:textSize="18sp" />

</LinearLayout>
